# 前端环境变量示例
# Vite 约定：所有暴露给客户端代码的变量必须以 VITE_ 开头
#
# 优先级（高到低）：
#   .env.[mode].local   —— 本地覆盖，不入 git
#   .env.[mode]         —— 按模式加载（development / production / 你自定义的 mode）
#   .env.local          —— 所有模式下的本地覆盖，不入 git
#   .env                —— 所有模式下的默认值

# ==== API 服务地址 ====
# 浏览器直连后端，跨域由后端 CORS 放行（不再使用 Vite dev proxy）
# 开发：填本地后端，例如 http://127.0.0.1:8000
# 生产：填线上后端域名，例如 https://api.your-domain.com
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_PREFIX=/api/v1

# ==== 应用元信息 ====
VITE_APP_NAME=Mindmap
VITE_APP_ENV=development
