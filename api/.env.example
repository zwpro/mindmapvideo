# 应用基础
APP_NAME=mindmap-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# CORS（前端 Vite 默认 5173）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 数据库（开发与生产均使用 MySQL）
# 运行时与 Alembic 迁移共用同一个异步 DSN（mysql+asyncmy）
DB_HOST=localhost
DB_PORT=3306
DB_USER=mindmap
DB_PASSWORD=mindmap
DB_NAME=mindmap
DATABASE_URL=mysql+asyncmy://mindmap:mindmap@localhost:3306/mindmap?charset=utf8mb4

# Redis（任务队列 / 缓存）
REDIS_URL=redis://localhost:6379/0

# JWT 鉴权
JWT_SECRET_KEY=please-change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# LLM - OpenAI 兼容
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 火山引擎方舟 Responses API
# API Key: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# Model ID: https://www.volcengine.com/docs/82379/1330310
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-251015
ARK_TIMEOUT_SECONDS=120

# AIGCDesk（Anthropic Messages 协议，端点：{BASE_URL}/v1/messages）
AIGCDESK_API_KEY=
AIGCDESK_BASE_URL=https://api.aigcdesk.com
AIGCDESK_MODEL=
AIGCDESK_TIMEOUT_SECONDS=120

# 视频产物存储
MEDIA_ROOT=./media
MEDIA_BASE_URL=http://localhost:8000/media
